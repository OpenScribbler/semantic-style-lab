{
  "schema_version": 1,
  "output_dir": ".style-lab",
  "projects": [
    {
      "name": "my-docs",
      "root": "../my-docs-repo",
      "include": [
        "docs/**/*.md",
        "docs/**/*.mdx"
      ],
      "exclude": [
        "**/node_modules/**",
        "**/.git/**",
        "**/dist/**",
        "**/generated/**"
      ],
      "max_files": 50,
      "sampling": {
        "strategy": "rule-stratified",
        "min_candidates_per_rule": 10
      }
    }
  ],
  "jev": {
    "model": "jev-latest"
  },
  "parsing": {
    "max_unparsed_file_ratio": 0
  },
  "rules": [
    "command-line",
    "real-time",
    "setup",
    "google-semicolons",
    "google-passive-hidden-actor"
  ],
  "passive": {
    "mode": "review",
    "guide": "google"
  }
}
