{
  "schema_version": 1,
  "output_dir": ".style-lab",
  "projects": [
    {
      "name": "my-docs",
      "root": "../my-docs-repo",
      "include": [
        "docs/**/*.md",
        "docs/**/*.mdx"
      ],
      "exclude": [
        "**/node_modules/**",
        "**/.git/**",
        "**/dist/**",
        "**/generated/**"
      ]
    }
  ],
  "jev": {
    "model": "jev-latest",
    "batch_question_limit": 200
  }
}
