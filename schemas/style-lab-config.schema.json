{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://semantic-style-lab.local/schemas/style-lab-config.schema.json",
  "title": "Semantic Style Lab CLI configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "projects"],
  "properties": {
    "schema_version": { "const": 1 },
    "output_dir": { "type": "string", "minLength": 1, "default": ".style-lab" },
    "projects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "root", "include"],
        "properties": {
          "name": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
          "root": { "type": "string", "minLength": 1 },
          "include": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "exclude": { "type": "array", "items": { "type": "string", "minLength": 1 }, "default": [] },
          "max_files": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "jev": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "model": { "type": "string", "minLength": 1, "default": "jev-latest" },
        "batch_question_limit": { "type": "integer", "minimum": 1, "maximum": 255, "default": 200 }
      }
    }
  }
}
