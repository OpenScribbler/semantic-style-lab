{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/semantic-style-lab/contextual-rule.schema.json",
  "title": "Contextual vocabulary rule",
  "type": "object",
  "required": [
    "id",
    "label",
    "vale_check",
    "source",
    "question",
    "variants",
    "contexts",
    "review_at",
    "flag_at"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "label": { "type": "string", "minLength": 1 },
    "vale_check": { "type": "string", "minLength": 1 },
    "source": {
      "type": "object",
      "required": ["guide", "url", "rationale"],
      "properties": {
        "guide": { "type": "string" },
        "url": { "type": "string", "format": "uri" },
        "rationale": { "type": "string" }
      },
      "additionalProperties": false
    },
    "question": { "type": "string", "minLength": 1 },
    "variants": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "contexts": {
      "type": "object",
      "minProperties": 2,
      "additionalProperties": {
        "type": "object",
        "required": ["description"],
        "properties": {
          "description": { "type": "string" },
          "expected": { "type": "string" },
          "preserve": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    },
    "review_at": { "type": "number", "minimum": 0, "maximum": 1 },
    "flag_at": { "type": "number", "minimum": 0, "maximum": 1 }
  },
  "additionalProperties": false
}
